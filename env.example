# ── SERVER CONFIG ──────────────────────────────────────────
PORT=5000
HOST=0.0.0.0

# ── DEFAULTS ───────────────────────────────────────────────
DEFAULT_AI=claude
DEFAULT_MODE=incognito

# ── CLAUDE CONFIG ──────────────────────────────────────────
# Claude App ID is auto-detected by default.
# Only set manually if auto-detect fails.
#
# To find your App ID manually:
# 1. Open PowerShell
# 2. Run: Get-StartApps | Where-Object { $_.Name -like "*Claude*" }
# 3. Copy the AppID value and paste it below (remove the #)
#
# CLAUDE_APP_ID=Claude_pzs8sxrjxfjjc!Claude
